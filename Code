-----------/*/ Project 4, "Is this numbers were effected by seasonality or we can count on it??" /*/------------------
/*1
    regarding the change of the sales value*/

WITH monthly_data AS(
        SELECT 
            EXTRACT(YEAR FROM time_periode::date) AS year,
            TRIM(TO_CHAR(time_periode::date, 'MONTH'))AS month,
            ROUND(AVG(value))AS monthly_value
        FROM value_stats
        GROUP BY year, month
        ORDER BY monthly_value, year DESC
)
    SELECT
      year,
      month,
      monthly_value,
      Round(monthly_value /
      AVG(monthly_value) OVER(
        PARTITION BY month
        ),2)AS seasonaly_adjusted
    FROM monthly_data
    ORDER BY year DESC, month

