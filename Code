------------------------------// Project 1, "Value vs volume" //-----------------------------

/*1
     Value VS volume monthly change throught years */

WITH value_data AS(
    SELECT 
        EXTRACT(YEAR FROM time_periode::Date)AS year,
        TRIM(TO_CHAR(time_periode::Date, 'month'))AS month,
        ROUND(AVG(value),2)AS Value_sales
    FROM value_stats
    GROUP BY  year, month
    
    )
    SELECT vd.year, 
        vd.month,
        value_sales,
        volume_sales
    FROM value_data vd 
    LEFT JOIN (
        SELECT  
    EXTRACT(YEAR FROM time_periode::Date)AS year,
    TRIM(TO_CHAR(time_periode::date, 'month'))AS month,
    ROUND(AVG(value),2) AS volume_sales
    
    FROM volume_stats vs
    WHERE value IS NOT NULL
    GROUP BY year, month
    ORDER BY year DESC,volume_sales)AS vs 
    ON vd.month = vs.month AND vd.year =vs.year
    
ORDER BY
        vd.year;


