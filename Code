----------------------// Project 2, "Large Business VS small Business" //------------------

/*1
    Small busnisses VS large Businesses for sales value */

SELECT
    time_periode AS date,
    vs.code AS category,
    value,
    description,
    agg,
    split_part(agg, '-', 2) AS b_type
FROM value_stats vs
    LEFT JOIN value_coding vc 
      ON vs.code = vc.code
WHERE description LIKE '%Large%' OR description LIKE '%Small%' AND vs.value is NOT NULL
    ORDER BY date;


