-----------/*/ Project 3, "Is there any Change in Consumbtion interest" /*/------------------

    /*1
        from the prospective of volume of sales */

WITH categories_volume AS(
    SELECT 
        DISTINCT(description),
        split_part(agg, '-', 1) AS category,
        code
        FROM volume_coding)
    SELECT DISTINCT ON(EXTRACT(YEAR FROM time_periode::date))
        EXTRACT(YEAR FROM time_periode::date) AS date,
        vs.code,
        value,
     category
   ,CASE
        WHEN category = 'Agg 47.7' THEN 'non-food industry'
        WHEN category = 'Agg 12' THEN 'food industry'
        WHEN category = 'Agg 21X' THEN 'non-food industry'
        WHEN category = 'Agg 47.6' THEN 'non-food industry'
        WHEN category = 'Agg 47.4' THEN 'non-food industry'
        WHEN category = 'Agg 47.2' THEN 'food industry'
        WHEN category = 'Agg 1' THEN 'food industry'
        WHEN category = 'Agg1' THEN 'food industry'
        WHEN category = 'Agg 47.9' THEN 'non-food industry'
        WHEN category = 'Agg 47.1' THEN 'food industry'
        WHEN category = 'Agg 47.3' THEN 'non-food industry'
        WHEN category = 'Agg 47.5' THEN 'non-food industry'
    END AS industry_type,
    description
    FROM categories_volume cv 
    LEFT JOIN volume_stats vs 
    ON vs.code=cv.code
    WHERE category <> 'none' AND category <> 'Agg 21' AND value IS NOT NULL
    ORDER BY date, value DESC


    /*2
        from the prospective of value of sales*/

WITH categories_value AS(
    SELECT 
        DISTINCT(description),
        code,
        split_part(agg, '-', 1) AS category
    FROM value_coding)
    SELECT DISTINCT ON(EXTRACT(YEAR FROM time_periode::date))
        EXTRACT(YEAR FROM time_periode::date) AS date,
        vs.code,
        value,
        category,
    CASE
        WHEN category = 'Agg 47.7' THEN 'non-food industry'
        WHEN category = 'Agg 12' THEN 'food industry'
        WHEN category = 'Agg 21X' THEN 'non-food industry'
        WHEN category = 'Agg 47.6' THEN 'non-food industry'
        WHEN category = 'Agg 47.4' THEN 'non-food industry'
        WHEN category = 'Agg 47.2' THEN 'food industry'
        WHEN category = 'Agg 1' THEN 'food industry'
        WHEN category = 'Agg1' THEN 'food industry'
        WHEN category = 'Agg 47.9' THEN 'non-food industry'
        WHEN category = 'Agg 47.1' THEN 'food industry'
        WHEN category = 'Agg 47.3' THEN 'non-food industry'
        WHEN category = 'Agg 47.5' THEN 'non-food industry'
    END AS industry_type,
    description
    FROM categories_value cv LEFT JOIN value_stats vs
    ON vs.code = cv.code 
    WHERE category <> 'none' AND category <> 'Agg 21' AND value IS NOT NULL
    ORDER BY date, value DESC

